{% for q in questions %}{{ "Context:\n" }}{{ state if state is string else state | tojson(separators=[',', ':']) }}{{ "\n\nTask type: " }}{{ q.type }}{{ "\nQuestion:\n" }}{{ q.instructions if q.instructions is string else q.instructions | tojson(separators=[',', ':']) }}{{ "\nOptions:" }}{% for o in q.options %}{{ sep }}{{ "\n<option>\n" }}{{ sep }}{{ mark_option }}{% set d = o.description %}{% if q.type == 'noul' and d is none %}{% set d = 'Yes' if o.key == 'true' else 'No' %}{% endif %}{{ {'description': d, 'key': o.key} | tojson(separators=[',', ':']) }}{{ "\n</option>" }}{% endfor %}{{ sep }}{{ mark_question }}{{ "\n\nSelect the single option best supported by the context and instructions.\nDecision:" }}{% endfor %}